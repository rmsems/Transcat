<Controller Use="Context" Name="Transcat">
<DataTypes Use="Context">
<DataType Name="Acrison_Feeder" Family="NoFamily" Class="User">
<Description>
<![CDATA[Acrison Feeder Tags]]>
</Description>
<Members>
<Member Name="ZZZZZZZZZZAcrison_Fe0" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/>
<Member Name="AutoMan" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZAcrison_Fe0" BitNumber="0" ExternalAccess="Read/Write">
<Description>
<![CDATA[On  - Auto Control - follows AutoRun bit,  Off - Manaul Control - follows Manual Run bit]]>
</Description>
</Member>
<Member Name="ManualRun" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZAcrison_Fe0" BitNumber="1" ExternalAccess="Read/Write">
<Description>
<![CDATA[On - Runs feeder in Manual, Off - Stops feeder in manual]]>
</Description>
</Member>
<Member Name="AutoRun" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZAcrison_Fe0" BitNumber="2" ExternalAccess="Read/Write">
<Description>
<![CDATA[On - Runs feeder in Auto Off - Stops feeder in Auto]]>
</Description>
</Member>
<Member Name="Interlock" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZAcrison_Fe0" BitNumber="3" ExternalAccess="Read/Write">
<Description>
<![CDATA[Interlock bit - if on - Feeder will not run]]>
</Description>
</Member>
<Member Name="Output" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZAcrison_Fe0" BitNumber="4" ExternalAccess="Read/Write">
<Description>
<![CDATA[On - Feeder runs, Off Feeder stops]]>
</Description>
</Member>
<Member Name="Int_Status" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[32 Status bits from feeder]]>
</Description>
</Member>
<Member Name="SP_HMI" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[setpoint from HMI]]>
</Description>
</Member>
<Member Name="SP_READ" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[setpoint read back from controller]]>
</Description>
</Member>
<Member Name="ZZZZZZZZZZAcrison_Fe9" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/>
<Member Name="Enable" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZAcrison_Fe9" BitNumber="0" ExternalAccess="Read/Write">
<Description>
<![CDATA[Enable logic to run feeder]]>
</Description>
</Member>
<Member Name="OT_Actual_Hz" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[The current output of the VFD in Hz]]>
</Description>
</Member>
<Member Name="FreqHz_Real" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[The command frequency of the drive in Hz]]>
</Description>
</Member>
<Member Name="CycleTime" DataType="TIMER" Dimension="0" Radix="NullType" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[running time of current cycle]]>
</Description>
</Member>
<Member Name="CampTime" DataType="TIMER" Dimension="0" Radix="NullType" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[running time of current campaign / batch]]>
</Description>
</Member>
<Member Name="TotalTime" DataType="TIMER" Dimension="0" Radix="NullType" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[total time the device / motor has run since last reset]]>
</Description>
</Member>
<Member Name="OneShots" DataType="BOOL" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[32 Booleans to hold one-shots assicated with this device]]>
</Description>
</Member>
<Member Name="TimeRunTarget" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Target Amount of time in seconds to run the device]]>
</Description>
</Member>
<Member Name="StartDelay" DataType="TIMER" Dimension="0" Radix="NullType" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Delay before motor start]]>
</Description>
</Member>
<Member Name="StartDelayms" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Start delay in milliseconds]]>
</Description>
</Member>
<Member Name="ZZZZZZZZZZAcrison_Fe20" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/>
<Member Name="TimeRunStart" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZAcrison_Fe20" BitNumber="0" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bit to start and run a timed run]]>
</Description>
</Member>
</Members>
